{
  "name": "dsh-subagent-model-config",
  "version": "0.3.0",
  "description": "Configure per-teammate model & reasoning effort for DeepSeek Harness native agent teams, with a settings UI; video-crew names are hard-gated (spawn refused unless a rule matches); under the video preset, spawned teammates get a persona override and a fail-closed toolFilter.allow whitelist. 为 DSH 原生编队队员可视化配置模型与推理档位；视频队员名硬闸门；video 预设下对子代理注入 persona 与 fail-closed 工具白名单。",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "node": ">=22.0.0",
    "dsh": ">=0.1.7-alpha.1"
  },
  "scripts": {
    "test": "node --test"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "author": {
    "name": "sequoiayunus-hue",
    "url": "https://github.com/sequoiayunus-hue"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sequoiayunus-hue/dsh-subagent-model-config.git"
  },
  "bugs": {
    "url": "https://github.com/sequoiayunus-hue/dsh-subagent-model-config/issues"
  },
  "homepage": "https://github.com/sequoiayunus-hue/dsh-subagent-model-config#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "subagent",
    "team",
    "teammate",
    "model-config",
    "reasoning-effort",
    "persona",
    "tool-filter"
  ]
}
